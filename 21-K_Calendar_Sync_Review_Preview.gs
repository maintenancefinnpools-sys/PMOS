/**
 * Authoritative Calendar Sync preview for a completed Calendar Review Session.
 * Review Session -> ONE detailed preview -> Approve & Prepare -> Job Center.
 */
function openReviewedCalendarSyncPreview() {
  const audit = runVerifiedCalendarPlanAuditReadOnly_();
  if (!audit.reviewComplete) throw new Error('Calendar review is not complete. Finish all review items before opening Calendar Sync Preview.');

  // The audit snapshot is evidence for review completion, not an executable
  // plan. Rebuild now so ledger decisions are resolved against current verified
  // Calendar state and this dialog previews the exact plan preparation will use.
  const preview = previewPmosCalendarSyncPlan();
  if (String(preview.reviewSessionId || '') !== String(audit.reviewSessionId || '')) {
    throw new Error('Calendar review session changed before Sync Preview could be built. Run Calendar Plan Audit again.');
  }
  if (!preview || !preview.plan || !Array.isArray(preview.plan.operations)) throw new Error('Calendar Sync Preview could not build the reviewed operation plan.');

  const resolutionErrors = Number(preview.reviewResolutionErrors || 0);
  const executorPending = Boolean(preview.reviewExecutorPending);
  const operations = preview.plan.operations.filter(isPmosExecutableOperation).map(buildPmosCalendarSyncPreviewRow_);
  const reviewedActions = Array.isArray(preview.reviewedActions) ? preview.reviewedActions : [];
  const ignored = reviewedActions.filter(function(a){ return String(a.reviewAction || '').toLowerCase() === 'ignore'; }).length;
  const reviewed = {
    matches:Number(preview.reviewedMatches || 0),
    temporary:Number(preview.reviewedTemporaryVisits || 0),
    kept:Number(preview.reviewedKeeps || 0),
    ignored:ignored,
    deletions:Number(preview.reviewedDeletions || 0),
    errors:resolutionErrors,
    actions:reviewedActions
  };

  const rowsJson = JSON.stringify(operations).replace(/</g,'\\u003c');
  const reviewedJson = JSON.stringify(reviewed).replace(/</g,'\\u003c');
  const blockedText = resolutionErrors > 0 ? resolutionErrors + ' reviewed action(s) could not be resolved safely.' : executorPending ? 'Reviewed Calendar execution support is not connected yet.' : operations.length === 0 ? 'There are no executable Calendar changes to approve.' : '';

  const html = HtmlService.createHtmlOutput(`<!DOCTYPE html><html><head><base target="_top"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;700;900&display=swap" rel="stylesheet"><style>
*{box-sizing:border-box}html,body{height:100%}body{font-family:'Mulish',Arial,sans-serif;margin:0;color:#293944;display:flex;flex-direction:column;overflow:hidden;background:#e5eaed}.content{padding:17px 18px 0;overflow:auto;flex:1;min-height:0}h2{margin:0 0 4px;font-weight:900}.muted{font-size:13px;color:#68747a}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:14px 0}.metric,.reviewMetric{position:relative;overflow:hidden;border:1px solid #d2dade;border-radius:9px;padding:10px 10px 10px 14px;background:#f9fafb;box-shadow:0 3px 10px rgba(46,56,66,.045)}.metric:before{content:'';position:absolute;inset:0 auto 0 0;width:4px;background:#017db1}.metric:nth-child(1):before{background:#3f8065}.metric:nth-child(2):before{background:#b88735}.metric:nth-child(3):before{background:#a6535d}.metric span,.reviewMetric span{display:block;font-size:11px;color:#68747a;font-weight:700;text-transform:uppercase;letter-spacing:.05em}.metric strong,.reviewMetric strong{display:block;margin-top:3px;font-size:17px;font-weight:900}.reviewBox{border:1px solid #bfd9e5;border-radius:9px;background:#e4f0f5;margin:0 0 12px;overflow:hidden}.reviewHead{padding:10px 12px;font-weight:900;display:flex;justify-content:space-between;align-items:center;cursor:pointer}.reviewGrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px;padding:0 10px 10px}.reviewMetric{box-shadow:none}.reviewDetails{display:none;border-top:1px solid #bfd9e5;padding:9px 12px;background:#f9fafb}.reviewBox.open .reviewDetails{display:block}.reviewAction{font-size:12px;padding:7px 0;border-bottom:1px solid #d2dade}.tools{display:flex;gap:8px;align-items:center;position:sticky;top:0;background:#e5eaed;padding:8px 0;z-index:3}.tools input,.tools select{border:1px solid #c7d2d8;border-radius:8px;padding:8px 10px;font:inherit;font-size:13px;color:#293944;background:#f9fafb}.tools input{flex:1;min-width:160px}.tools input:focus,.tools select:focus{outline:2px solid #75c4e5;outline-offset:1px}.count{font-size:12px;color:#68747a;white-space:nowrap}.row{border:1px solid #d2dade;border-left:5px solid #68747a;border-radius:9px;margin:8px 0;background:#f9fafb;overflow:hidden;box-shadow:0 3px 10px rgba(46,56,66,.045)}.row.CREATE{border-left-color:#3f8065}.row.UPDATE{border-left-color:#b88735}.row.DELETE{border-left-color:#a6535d}.head{display:grid;grid-template-columns:74px 1fr auto;gap:10px;align-items:center;padding:10px 12px;cursor:pointer}.badge{font-size:11px;font-weight:900}.title{font-weight:900}.summary{font-size:12px;color:#68747a;margin-top:3px}.details{display:none;border-top:1px solid #d2dade;padding:11px 12px;background:#edf1f3}.row.open .details{display:block}.changeBox{border:1px solid #ddc88f;background:#f4ead1;border-radius:8px;padding:9px 10px;margin-bottom:10px}.changeBox strong{font-size:12px}.changeItem{font-size:12px;margin-top:5px}.compare{display:grid;grid-template-columns:1fr 1fr;gap:10px}.card{border:1px solid #d2dade;border-radius:8px;padding:9px;background:#f9fafb}.card h4{margin:0 0 7px;font-size:12px;font-weight:900}.line{font-size:12px;margin:4px 0;padding:3px 5px;border-radius:5px;word-break:break-word}.line.changed{background:#f4ead1;outline:1px solid #ddc88f}.line.changed .label{color:#765b21;font-weight:700}.label{color:#68747a}.reason{margin-top:9px;font-size:12px;color:#68747a}.notice{margin:10px 0;padding:11px;border-radius:9px;background:#f4ead1;color:#765b21;font-weight:700}.empty{padding:18px;color:#68747a;text-align:center}.actions{display:flex;justify-content:flex-end;gap:8px;padding:12px 18px 14px;background:#f2f5f6;border-top:1px solid #d2dade;box-shadow:0 -4px 12px rgba(46,56,66,.05);flex:0 0 auto}button{border:1px solid #c7d2d8;border-radius:8px;padding:9px 12px;font:inherit;font-weight:700;cursor:pointer}.primary{background:#0f5470;color:#fff;border-color:#0f5470}.primary:hover{background:#017db1;border-color:#017db1}.secondary{background:#f2f5f6;color:#293944}.secondary:hover{background:#e7f2f7;border-color:#75c4e5}button:disabled{opacity:.5;cursor:default}@media(max-width:680px){.reviewGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.tools{align-items:stretch;flex-wrap:wrap}.tools input{flex-basis:100%}.compare{grid-template-columns:1fr}}
</style></head><body><div class="content">
<h2>Calendar Sync Preview</h2><div class="muted">Review every proposed Calendar change for ${escapePmosSyncPreviewHtml_(preview.calendarName || '')}. In expanded rows, yellow fields are the exact values PMOS intends to change.</div>
<div class="metrics"><div class="metric"><span>Create</span><strong>${Number(preview.creates || 0)}</strong></div><div class="metric"><span>Update</span><strong>${Number(preview.updates || 0)}</strong></div><div class="metric"><span>Delete</span><strong>${Number(preview.deletes || 0)}</strong></div></div>
<div id="reviewBox" class="reviewBox"><div class="reviewHead" onclick="toggleReview()"><span>Reviewed Event Actions</span><span id="reviewChevron">▼</span></div><div id="reviewGrid" class="reviewGrid"></div><div id="reviewDetails" class="reviewDetails"></div></div>
${blockedText ? '<div class="notice">' + escapePmosSyncPreviewHtml_(blockedText) + '</div>' : ''}
<div class="tools"><input id="search" placeholder="Search customer, layer, series ID…"><select id="filter" aria-label="Filter Calendar changes"><option value="ALL">All changes</option><option value="UPDATE">Updates only</option><option value="CREATE">Creates only</option><option value="DELETE">Deletions only</option></select><span id="visibleCount" class="count"></span></div><div id="rows"></div></div>
<div class="actions"><button id="approve" class="primary" ${blockedText ? 'disabled' : ''}>Approve & Prepare Sync</button><button class="secondary" onclick="google.script.host.close()">Close</button></div>
<script>
const rows=${rowsJson},reviewed=${reviewedJson};
const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function renderReview(){const items=[['Customer matches',reviewed.matches],['Temporary visits',reviewed.temporary],['Ignored / kept',reviewed.ignored+reviewed.kept],['Approved deletions',reviewed.deletions],['Resolution errors',reviewed.errors]];document.getElementById('reviewGrid').innerHTML=items.map(x=>'<div class="reviewMetric"><span>'+esc(x[0])+'</span><strong>'+Number(x[1]||0)+'</strong></div>').join('');const a=reviewed.actions||[];document.getElementById('reviewDetails').innerHTML=a.length?a.map(x=>'<div class="reviewAction"><b>'+esc(x.reviewAction||x.action||'Reviewed action')+'</b> — '+esc(x.customerName||x.title||x.seriesKey||'Calendar event')+(x.reason?' · '+esc(x.reason):'')+'</div>').join(''):'<div class="muted">No reviewed event actions were required for this sync.</div>';}
function toggleReview(){const b=document.getElementById('reviewBox');b.classList.toggle('open');document.getElementById('reviewChevron').textContent=b.classList.contains('open')?'▲':'▼';}
function fmtTime(v){if(!v)return '';if(/^\\d{2}:\\d{2}/.test(String(v))){const p=String(v).split(':');let h=Number(p[0]),m=p[1],ap=h>=12?'PM':'AM';h=h%12||12;return h+':'+m+' '+ap;}const d=new Date(v);if(isNaN(d.getTime()))return String(v);return d.toLocaleTimeString([],{hour:'numeric',minute:'2-digit'});}
function fmtDate(v){if(!v)return '';const d=new Date(v);if(isNaN(d.getTime()))return String(v);return d.toLocaleDateString([],{year:'numeric',month:'short',day:'numeric'});}
function fieldChanged(changed,key){return (changed||[]).some(x=>String(x).toLowerCase()===String(key).toLowerCase());}
function displayRecordValue(key,v){if(key==='start'||key==='end')return fmtTime(v);if(key==='until')return fmtDate(v);if(key==='durationMinutes')return v===''?'':String(v)+' min';return v;}
function recordCard(label,r,changed){r=r||{};const values=[['Customer ID','customerId',r.customerId],['Layer','layer',r.layer],['Title','title',r.title],['Start','startTime',r.start],['End','endTime',r.end],['Duration','durationMinutes',r.durationMinutes],['Until','until',r.until],['Series key','seriesKey',r.seriesKey],['Series ID','seriesId',r.seriesId],['Location','location',r.location],['Description','description',r.description]].filter(x=>x[2]!==''&&x[2]!=null);return '<div class="card"><h4>'+esc(label)+'</h4>'+(values.length?values.map(x=>'<div class="line '+(fieldChanged(changed,x[1])?'changed':'')+'"><span class="label">'+esc(x[0])+':</span> '+esc(displayRecordValue(x[1],x[2]))+'</div>').join(''):'<div class="line label">None</div>')+'</div>';}
function changeLabel(k){return ({title:'Title',startTime:'Start time',endTime:'End time',durationMinutes:'Duration',location:'Location',description:'Description',color:'Colour',until:'Until'})[k]||k;}
function changeValue(k,v){if(k==='startTime'||k==='endTime')return fmtTime(v);if(k==='durationMinutes')return v==null?'':String(v)+' min';if(k==='until')return fmtDate(v);return String(v==null?'':v);}
function exactChanges(r){const c=r.changes||{},keys=r.changedFields||[];if(!keys.length)return '';return '<div class="changeBox"><strong>Exact changes PMOS will make</strong>'+keys.map(k=>{const x=c[k]||{};return '<div class="changeItem"><b>'+esc(changeLabel(k))+':</b> '+esc(changeValue(k,x.before))+' → '+esc(changeValue(k,x.after))+'</div>';}).join('')+'</div>';}
function rowHtml(r,i){const c=r.current||{},p=r.planned||{};let s=r.action==='UPDATE'?(c.layer||c.title||'Existing series')+' → '+(p.layer||p.title||'Planned series'):r.action==='CREATE'?(p.layer||p.title||'New recurring series'):(c.layer||c.title||'Existing recurring series');return '<div class="row '+esc(r.action)+'" data-i="'+i+'"><div class="head" onclick="toggle('+i+')"><div class="badge">'+esc(r.action)+'</div><div><div class="title">'+esc(r.title||r.entityId||'Calendar series')+'</div><div class="summary">'+esc(s)+(r.changedFields&&r.changedFields.length?' · '+esc(r.changedFields.map(changeLabel).join(', ')):'')+'</div></div><div>▼</div></div><div class="details">'+exactChanges(r)+'<div class="compare">'+recordCard('Current',c,r.changedFields)+recordCard('Planned',p,r.changedFields)+'</div><div class="reason">Only highlighted fields are part of this update. Unhighlighted planned fields are context and are not evidence of a change.</div>'+(r.reason?'<div class="reason"><b>Reason:</b> '+esc(r.reason)+'</div>':'')+(r.identityReconciled?'<div class="reason"><b>Identity reconciled:</b> '+esc(r.previousSeriesKey||'legacy identity')+' → '+esc(p.seriesKey||r.entityId||'current identity')+'</div>':'')+'</div></div>';}
function render(){const q=document.getElementById('search').value.trim().toLowerCase(),f=document.getElementById('filter').value,v=[];rows.forEach((r,i)=>{if((f==='ALL'||r.action===f)&&(!q||JSON.stringify(r).toLowerCase().includes(q)))v.push([r,i]);});document.getElementById('rows').innerHTML=v.length?v.map(x=>rowHtml(x[0],x[1])).join(''):'<div class="empty">No matching operations.</div>';document.getElementById('visibleCount').textContent=v.length+' of '+rows.length;}
function toggle(i){const e=document.querySelector('.row[data-i="'+i+'"]');if(e)e.classList.toggle('open');}
document.getElementById('search').addEventListener('input',render);document.getElementById('filter').addEventListener('change',render);document.getElementById('approve').onclick=function(){const b=this;b.disabled=true;b.textContent='Preparing Sync…';google.script.run.withSuccessHandler(function(){b.textContent='Prepared';google.script.host.close();}).withFailureHandler(function(e){b.disabled=false;b.textContent='Approve & Prepare Sync';alert(e&&e.message?e.message:String(e));}).approveDetailedCalendarSyncPreview();};renderReview();render();
</script></body></html>`).setWidth(920).setHeight(700);
  SpreadsheetApp.getUi().showModalDialog(html,'Calendar Sync Preview');
  return {opened:true,reviewSessionId:preview.reviewSessionId||'',operationCount:operations.length};
}

function approveDetailedCalendarSyncPreview(){const prepared=prepareReviewedCalendarSyncWindow_();openPmosJobEngine('CALENDAR_SYNC');return {prepared:true,planId:String(prepared&&prepared.planId||''),reviewSessionId:String(prepared&&prepared.sessionId||''),total:Number(prepared&&prepared.total||0),creates:Number(prepared&&prepared.creates||0),updates:Number(prepared&&prepared.updates||0),deletes:Number(prepared&&prepared.deletes||0)};}
function buildPmosCalendarSyncPreviewRow_(operation){const p=operation&&operation.payload||{},c=p.current||{},d=p.desired||{};return {operationId:String(operation&&operation.id||''),action:String(operation&&operation.action||'').toUpperCase(),entityId:String(operation&&operation.entityId||''),title:String(d.title||d.eventTitle||c.title||c.eventTitle||operation.entityId||''),reason:String(operation&&operation.reason||''),changedFields:Array.isArray(p.changedFields)?p.changedFields.slice():[],changes:p.changes||{},current:buildPmosCalendarSyncPreviewRecord_(c),planned:buildPmosCalendarSyncPreviewRecord_(d),identityReconciled:Boolean(c.metadata&&c.metadata.identityReconciled),previousSeriesKey:String(c.metadata&&c.metadata.previousSeriesKey||'')};}
function buildPmosCalendarSyncPreviewRecord_(record){const v=record||{};return {seriesKey:String(v.seriesKey||''),customerId:String(v.customerId||''),layer:String(v.layer||''),title:String(v.title||v.eventTitle||''),start:formatPmosSyncPreviewValue_(v.start),end:formatPmosSyncPreviewValue_(v.end),durationMinutes:calculatePmosSyncPreviewDuration_(v.start,v.end),until:formatPmosSyncPreviewValue_(v.until),seriesId:String(v.seriesId||v.id||''),location:String(v.location||''),description:String(v.description||''),color:String(v.color||''),status:String(v.status||'')};}
function calculatePmosSyncPreviewDuration_(start,end){if(!start||!end)return '';const a=new Date(start),b=new Date(end);if(!Number.isFinite(a.getTime())||!Number.isFinite(b.getTime()))return '';return Math.round((b.getTime()-a.getTime())/60000);}
function formatPmosSyncPreviewValue_(value){if(value==null||value==='')return '';if(value instanceof Date)return value.toISOString();return String(value);}
function escapePmosSyncPreviewHtml_(value){return String(value==null?'':value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');}
