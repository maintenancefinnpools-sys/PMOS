function maintenanceRouteShards(frequency){var f=String(frequency||'').toLowerCase();if(f.indexOf('monthly')>=0)return[{start:0,count:5,label:'Week 1'},{start:5,count:5,label:'Week 2'},{start:10,count:5,label:'Week 3'},{start:15,count:5,label:'Week 4'}];if(f.indexOf('bi')>=0)return[{start:0,count:5,label:'Weeks 1 & 3'},{start:5,count:5,label:'Weeks 2 & 4'}];if(f.indexOf('twice')>=0)return[{start:0,count:2,label:'Group 1'},{start:2,count:2,label:'Group 2'},{start:4,count:2,label:'Group 3'},{start:6,count:2,label:'Group 4'},{start:8,count:2,label:'Group 5'}];return[{start:0,count:1,label:'Monday'},{start:1,count:1,label:'Tuesday'},{start:2,count:1,label:'Wednesday'},{start:3,count:1,label:'Thursday'},{start:4,count:1,label:'Friday'}]}
