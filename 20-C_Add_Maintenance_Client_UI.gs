/**
 * Add Maintenance Client dialog v2.
 * The backend creation and recommendation functions remain in 20_Add_Maintenance_Client.gs.
 */
function showAddMaintenanceClientV2() {
  const today = Utilities.formatDate(new Date(), PMOS.TIMEZONE, 'yyyy-MM-dd');
  const html = HtmlService.createHtmlOutput(`
<!DOCTYPE html><html><head><base target="_top"><style>
*{box-sizing:border-box}body{margin:0;padding:18px;font-family:Arial,sans-serif;color:#1f2937}h2{margin:0 0 5px}.muted{font-size:12px;color:#64748b}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;margin-top:16px}.full{grid-column:1/-1}label{display:flex;flex-direction:column;gap:5px;font-size:12px;font-weight:700}input,select,textarea{width:100%;padding:9px;border:1px solid #cbd5e1;border-radius:7px;font:inherit}textarea{min-height:68px}.section{grid-column:1/-1;margin-top:5px;padding-top:11px;border-top:1px solid #e2e8f0;font-size:13px;font-weight:700}.address-wrap{position:relative}.address-list{display:none;position:absolute;z-index:50;left:0;right:0;top:100%;max-height:235px;overflow:auto;background:white;border:1px solid #94a3b8;border-radius:0 0 8px 8px;box-shadow:0 10px 22px rgba(15,23,42,.18)}.address-option{display:block;width:100%;border:0;border-bottom:1px solid #e2e8f0;background:white;padding:10px;text-align:left;cursor:pointer}.address-option:hover,.address-option.active{background:#eff6ff}.address-main{font-weight:700}.address-source{margin-top:2px;font-size:10px;color:#64748b}.note{grid-column:1/-1;padding:10px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;font-size:12px;white-space:pre-wrap}.recommendations{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.rec{padding:11px;text-align:left;background:#fff;border:2px solid #dbeafe;border-radius:10px;cursor:pointer}.rec.selected{border-color:#2563eb;background:#eff6ff}.rec-title{display:flex;justify-content:space-between;gap:8px;font-size:13px;font-weight:700}.rec-detail{margin-top:5px;color:#475569;font-size:11px;line-height:1.4}.manual{grid-column:1/-1;padding:10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:9px}.manual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.buttons{display:flex;gap:8px;margin-top:16px}.buttons button{padding:9px 13px;border:0;border-radius:8px;font-weight:700;cursor:pointer}.primary{background:#2563eb;color:white}.secondary{background:#e2e8f0}.status{margin-top:12px;min-height:48px;padding:10px;background:#f1f5f9;border-radius:8px;white-space:pre-wrap;font-size:12px}.error{background:#fee2e2;color:#991b1b}button:disabled{opacity:.5}@media(max-width:760px){.grid{grid-template-columns:1fr}.full,.section,.note,.recommendations,.manual{grid-column:1}.recommendations,.manual-grid{grid-template-columns:1fr}}
</style></head><body>
<h2>Add Maintenance Client</h2><div class="muted">Start typing the service address. PMOS will show stored customer addresses first and Google Maps matches for new addresses.</div>
<div class="grid"><div class="section">Customer information</div>
<label>Customer name<input id="name"></label><label>Service address<div class="address-wrap"><input id="address" autocomplete="off" placeholder="Start typing an address…" oninput="queueAddressSearch(this.value)" onkeyup="queueAddressSearch(this.value)" onfocus="queueAddressSearch(this.value)" onpaste="setTimeout(function(){queueAddressSearch(document.getElementById('address').value)},0)"><div id="addressList" class="address-list"></div></div></label><label>Phone<input id="phone"></label><label>Email<input id="email" type="email"></label><label class="full">Notes<textarea id="notes"></textarea></label>
<div class="section">Maintenance schedule</div><label>Frequency<select id="frequency"><option>Weekly</option><option>Biweekly</option><option>Monthly</option><option>Twice Weekly</option></select></label><label>Effective date<input id="effectiveDate" type="date" value="${today}"></label>
<div id="recommendationStatus" class="note">Type at least 3 address characters to see suggestions.</div><div id="recommendations" class="recommendations"></div>
<div class="manual"><div class="muted" style="margin-bottom:8px"><b>Manual placement</b> — recommendations fill these fields, but every value remains editable.</div><div class="manual-grid"><label>Primary service day<select id="day"><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option></select></label><label id="secondDayLabel" style="display:none">Second service day<select id="secondDay"><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option></select></label><label id="weekLabel">Rotation week<select id="week"><option value="1">Week 1</option><option value="2">Week 2</option><option value="3">Week 3</option><option value="4">Week 4</option></select></label><label>Stop position<input id="stop" type="number" min="1" placeholder="Add at end of route"></label><label>Calendar title<input id="calendarTitle" placeholder="Defaults to customer name"></label></div></div></div>
<div class="buttons"><button id="refreshButton" class="secondary">Refresh Recommendations</button><button id="saveButton" class="primary">Create Client and Sync Calendar</button><button id="cancelButton" class="secondary">Cancel</button></div><div id="status" class="status">Ready.</div>
<script>
var recTimer=null,addressTimer=null,recRequest=0,addressRequest=0,currentRecommendations=[];
function byId(id){return document.getElementById(id)}
function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]})}
function formValues(){return{name:byId('name').value,address:byId('address').value,phone:byId('phone').value,email:byId('email').value,notes:byId('notes').value,frequency:byId('frequency').value,effectiveDate:byId('effectiveDate').value,week:Number(byId('week').value),day:byId('day').value,secondDay:byId('secondDay').value,stop:byId('stop').value,calendarTitle:byId('calendarTitle').value}}
function scheduleChanged(){var f=byId('frequency').value;byId('secondDayLabel').style.display=f==='Twice Weekly'?'flex':'none';byId('weekLabel').style.display=(f==='Weekly'||f==='Twice Weekly')?'none':'flex'}
function queueRecommendations(immediate){clearTimeout(recTimer);recTimer=setTimeout(loadRecommendations,immediate?50:700)}
function loadRecommendations(){var data=formValues(),address=data.address.trim();if(address.length<3){currentRecommendations=[];byId('recommendations').innerHTML='';byId('recommendationStatus').textContent='Type at least 3 address characters to see suggestions.';return}var request=++recRequest;byId('recommendationStatus').textContent='Searching Google Maps and calculating route placement…';google.script.run.withSuccessHandler(function(result){if(request!==recRequest)return;currentRecommendations=(result&&result.recommendations)||[];byId('recommendationStatus').textContent=(result&&result.qualityMessage)||'Recommendations calculated.';renderRecommendations()}).withFailureHandler(function(error){if(request!==recRequest)return;currentRecommendations=[];byId('recommendations').innerHTML='';byId('recommendationStatus').textContent='Address was not recognized for automatic recommendations. Check the address or use manual placement.\n'+(error&&error.message?error.message:String(error))}).recommendMaintenanceClientRotations(data)}
function renderRecommendations(){var box=byId('recommendations');box.innerHTML='';currentRecommendations.forEach(function(r,i){var b=document.createElement('button');b.type='button';b.className='rec';b.addEventListener('click',function(){document.querySelectorAll('.rec').forEach(function(x){x.classList.remove('selected')});b.classList.add('selected');byId('day').value=r.day;if(r.secondDay)byId('secondDay').value=r.secondDay;if(r.week)byId('week').value=String(r.week);if(r.position)byId('stop').value=String(r.position);byId('recommendationStatus').textContent='Recommendation applied. Manual fields remain editable.'});var between=r.previousName||r.nextName?(r.previousName||'Start of route')+' → New client → '+(r.nextName||'End of route'):'New client at route start';b.innerHTML='<div class="rec-title"><span>'+(i+1)+'. '+esc(r.label)+'</span><span>'+esc(r.rating)+' · '+Math.round(r.score)+'</span></div><div class="rec-detail">'+esc(r.rotationLabel)+'</div><div class="rec-detail">'+esc(between)+'</div><div class="rec-detail">Added travel: '+Number(r.addedDistanceKm||0).toFixed(1)+' km · Average route: '+Number(r.customerCount||0).toFixed(1)+' stops</div>';box.appendChild(b)})}
function queueAddressSearch(value){clearTimeout(addressTimer);clearTimeout(recTimer);var q=String(value==null?byId('address').value:value).trim();byId('recommendationStatus').textContent=q.length<3?'Type at least 3 address characters to see suggestions.':'Searching PMOS addresses and Google Maps…';if(q.length<3){hideAddresses();return}addressTimer=setTimeout(function(){var request=++addressRequest;google.script.run.withSuccessHandler(function(items){if(request!==addressRequest)return;renderAddresses(items||[]);byId('recommendationStatus').textContent=items&&items.length?'Choose an address suggestion, or continue typing.':'No dropdown matches yet. Continue typing or refresh recommendations.'}).withFailureHandler(function(error){hideAddresses();byId('recommendationStatus').textContent='Address suggestions could not load. You can still type the full address and refresh recommendations.\n'+(error&&error.message?error.message:String(error))}).suggestPmosAddresses(q,8)},300)}
function renderAddresses(items){var list=byId('addressList');list.innerHTML='';if(!items.length){hideAddresses();return}items.forEach(function(item){var b=document.createElement('button');b.type='button';b.className='address-option';b.innerHTML='<div class="address-main">'+esc(item.address)+'</div><div class="address-source">'+esc(item.source||'Address match')+'</div>';b.addEventListener('mousedown',function(event){event.preventDefault();byId('address').value=item.address;hideAddresses();byId('recommendationStatus').textContent='Address selected. Calculating route recommendations…';queueRecommendations(true)});list.appendChild(b)});list.style.display='block'}
function hideAddresses(){byId('addressList').style.display='none';byId('addressList').innerHTML=''}
function saveClient(){var data=formValues();if(!data.name.trim()||!data.address.trim()){byId('status').className='status error';byId('status').textContent='Customer name and service address are required.';return}if(data.frequency==='Twice Weekly'&&data.day===data.secondDay){byId('status').className='status error';byId('status').textContent='Twice-weekly service requires two different weekdays.';return}byId('saveButton').disabled=true;byId('status').className='status';byId('status').textContent='Creating customer, route records, and Calendar Sync job…';google.script.run.withSuccessHandler(function(result){byId('status').textContent=result.summary;byId('saveButton').textContent='Created'}).withFailureHandler(function(error){byId('saveButton').disabled=false;byId('status').className='status error';byId('status').textContent=error&&error.message?error.message:String(error)}).createMaintenanceClient(data)}
function initializeDialog(){var address=byId('address');address.addEventListener('blur',function(){setTimeout(hideAddresses,180)});byId('frequency').addEventListener('change',scheduleChanged);byId('refreshButton').addEventListener('click',loadRecommendations);byId('saveButton').addEventListener('click',saveClient);byId('cancelButton').addEventListener('click',function(){google.script.host.close()});scheduleChanged()}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',initializeDialog)}else{initializeDialog()}
</script></body></html>`).setWidth(900).setHeight(840);
  SpreadsheetApp.getUi().showModalDialog(html, 'Add Maintenance Client');
}