function clearAddressSelection(){selectedAddress=null;selectedPlacements=[];clearSuggestedStop();byId('addressDetails').style.display='none';byId('addressDetails').textContent='';byId('recommendations').innerHTML='';byId('recommendationStatus').classList.remove('calculating');currentRecommendations=[];setAddressRouteStatus('',false)}
function beginAddressSearch(value){if(String(value||'').trim().length>=3)setAddressRouteStatus('Loading address suggestions…',false);else setAddressRouteStatus('',false);queueAddressSearch(value)}
