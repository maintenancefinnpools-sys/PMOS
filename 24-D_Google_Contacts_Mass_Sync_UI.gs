und:#f7f9fa;box-shadow:0 18px 60px rgba(0,0,0,.25)"><div style="display:flex;align-items:center;gap:9px;padding:16px;border-bottom:1px solid #d5dde1"><input id="contactFinderQuery" style="flex:1;padding:10px;border:1px solid #aebdc5;border-radius:7px" placeholder="Search name, address, phone, or email"><button onclick="runContactFinderSearch()" style="padding:10px;border:0;border-radius:7px;background:#0f5470;color:#fff;font-weight:bold">Search</button><button onclick="closeContactFinder()" style="padding:10px;border:0;background:transparent;font-weight:bold">Close</button></div><div id="contactFinderResults" style="padding:12px 16px 18px">Enter a search.</div></div>';document.body.appendChild(host);document.getElementById('contactFinderQuery').addEventListener('keydown',function(event){if(event.key==='Enter')runContactFinderSearch()});return host}function openContactFinder(button){var host=ensureContactFinder(),input=document.getElementById('contactFinderQuery');finderCustomerId=button.dataset.id;host.style.display='block';input.value=button.dataset.name||button.dataset.address||'';input.focus();runContactFinderSearch()}function closeContactFinder(){var host=document.getElementById('contactFinder');if(host)host.style.display='none'}function runContactFinderSearch(){var query=document.getElementById('contactFinderQuery').value,results=document.getElementById('contactFinderResults');results.textContent='Searching Google Contacts…';google.script.run.withSuccessHandler(renderContactFinderResults).withFailureHandler(function(error){results.textContent=error&&error.message?error.message:String(error)}).searchPmosGoogleContactsForManualLink(query)}function renderContactFinderResults(rows){var results=document.getElementById('contactFinderResults');results.innerHTML=rows.length?rows.map(function(row){var details=[row.address,row.phone,row.email].filter(Boolean).join(' · ');return '<button type="button" data-resource="'+esc(row.resourceName)+'" data-name="'+esc(row.displayName)+'" onclick="chooseManualContact(this)" style="display:block;width:100%;margin:5px 0;padding:11px;border:1px solid #d1dade;border-radius:8px;background:#fff;color:#293944;text-align:left;cursor:pointer"><b>'+esc(row.displayName)+'</b><span style="display:block;margin-top:4px;color:#68747a;font-size:11px">'+esc(details||'No additional contact details')+'</span></button>'}).join(''):'No matching Google Contacts found.'}function chooseManualContact(button){if(!confirm('Link '+button.dataset.name+' to this PMOS customer?'))return;var results=document.getElementById('contactFinderResults');results.textContent='Linking contact…';google.script.run.withSuccessHandler(function(){closeContactFinder();loadPreview()}).withFailureHandler(function(error){results.textContent=error&&error.message?error.message:String(error)}).linkPmosCustomerGoogleContact(finderCustomerId,button.dataset.resource)}
