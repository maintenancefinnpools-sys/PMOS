/** Guarded mass synchronization between PMOS Customers and Google Contacts. */
function showPmosGoogleContactsMassSync() {
  const html = HtmlService.createHtmlOutput(buildPmosGoogleContactsMassSyncHtml_()).setWidth(1060).setHeight(760);
  SpreadsheetApp.getUi().showModelessDialog(html, 'Google Contacts Mass Sync');
}

function buildPmosGoogleContactsMassSyncHtml_() {
  return `<!doctype html><html><head><base target="_top"><style>
.metric{color:#293944;text-align:left;cursor:pointer}.metric:hover{border-color:#7fa4b5;background:#f7fbfd}.metric.active{border-color:#0f5470;background:#e5f1f6;box-shadow:0 0 0 2px rgba(15,84,112,.1)}
*{box-sizing:border-box}body{margin:0;background:#e7ecef;color:#293944;font:13px Arial,sans-serif}.head{padding:20px 24px;background:#f7f9fa;border-bottom:1px solid #ccd6db}.head h2{margin:0 0 6px;color:#0f5470}.head p{margin:0;color:#64747d}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;padding:15px 24px}.metric{padding:12px;border:1px solid #d1dade;border-radius:9px;background:#fff}.metric b{display:block;font-size:21px;color:#0f5470}.controls{display:flex;align-items:center;gap:9px;padding:0 24px 14px}.controls button{padding:9px 13px;border:1px solid #0f5470;border-radius:7px;background:#fff;color:#0f5470;font-weight:bold;cursor:pointer}.controls button.primary{background:#0f5470;color:#fff}.controls button:disabled{opacity:.5;cursor:wait}.status{margin-left:auto;color:#64747d}.table-wrap{height:510px;overflow:auto;margin:0 24px 20px;border:1px solid #ccd6db;border-radius:9px;background:#fff}table{width:100%;border-collapse:collapse}th{position:sticky;top:0;z-index:1;padding:10px;background:#566a76;color:#fff;text-align:left;font-size:11px}td{padding:10px;border-bottom:1px solid #e6ebed;vertical-align:top}.small{margin-top:3px;color:#6d7a80;font-size:11px}.ready{color:#17673b;font-weight:bold}.review{color:#936400;font-weight:bold}.unmatched,.broken{color:#9a3434;font-weight:bold}.candidate{margin-top:4px}.empty{padding:45px;text-align:center;color:#68747a}
</style></head><body><div class="head"><h2>Google Contacts Mass Sync</h2><p>Review matches and field differences before changing either system. Unmatched customers are never created automatically.</p></div><div id="summary" class="summary"></div><div class="controls"><button id="refresh" onclick="loadPreview()">Refresh preview</button><button class="primary" id="pull" onclick="startSync('PULL')">Pull selected from Google</button><button class="primary" id="push" onclick="startSync('PUSH')">Push selected to Google</button><span id="status" class="status">Loading…</span></div><div class="table-wrap"><div id="table" class="empty">Reading customers and Google Contacts…</div></div><script>
var preview=null,busy=false;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function setBusy(value,message){busy=value;['refresh','pull','push'].forEach(function(id){document.getElementById(id).disabled=value});document.getElementById('status').textContent=message||''}function metric(label,value){return '<div class="metric"><b>'+value+'</b>'+label+'</div>'}function loadPreview(){setBusy(true,'Building preview…');google.script.run.withSuccessHandler(renderPreview).withFailureHandler(fail).previewPmosGoogleContactsMassSync()}function renderPreview(data){preview=data;document.getElementById('summary').innerHTML=metric('Ready to review',data.ready)+metric('Needs match review',data.review)+metric('No match',data.unmatched)+metric('Broken links',data.broken);document.getElementById('table').innerHTML='<table><thead><tr><th style="width:34px"><input id="all" type="checkbox" checked onchange="toggleAll(this.checked)"></th><th>PMOS customer</th><th>Google Contact</th><th>Match</th><th>Different fields</th></tr></thead><tbody>'+data.rows.map(rowHtml).join('')+'</tbody></table>';setBusy(false,data.ready+' safe matches available')}function rowHtml(row){var ready=row.status==='READY',candidates=(row.candidates||[]).map(function(c){return '<div class="candidate">'+esc(c.displayName)+' — '+esc(c.matchReason)+'</div>'}).join('');return '<tr><td>'+(ready?'<input class="pick" type="checkbox" checked data-id="'+esc(row.customerId)+'" data-resource="'+esc(row.resourceName)+'">':'')+'</td><td><b>'+esc(row.customerName)+'</b><div class="small">'+esc(row.customerId)+'</div></td><td>'+esc(row.contactName||'—')+(candidates?'<div class="small">Candidates:'+candidates+'</div>':'')+'</td><td class="'+row.status.toLowerCase()+'">'+esc(ready?row.matchReason:row.status)+'</td><td>'+esc((row.differences||[]).join(', ')||'—')+'</td></tr>'}function toggleAll(checked){Array.prototype.forEach.call(document.querySelectorAll('.pick'),function(box){box.checked=checked})}function selections(){return Array.prototype.filter.call(document.querySelectorAll('.pick'),function(box){return box.checked}).map(function(box){return{customerId:box.dataset.id,resourceName:box.dataset.resource}})}function startSync(direction){var chosen=selections();if(!chosen.length){alert('Select at least one safely matched customer.');return}var verb=direction==='PULL'?'replace PMOS fields with Google Contact information':'replace Google Contact fields with PMOS information';if(!confirm(verb+' for '+chosen.length+' selected customer'+(chosen.length===1?'':'s')+'?\\n\\nOnly the customers checked in this preview will be changed.'))return;setBusy(true,'Preparing '+chosen.length+' customers…');runBatch(direction,chosen,0,0,[])}function runBatch(direction,chosen,index,success,errors){var batch=chosen.slice(index,index+12);if(!batch.length){var message='Complete: '+success+' synchronized';if(errors.length)message+=' · '+errors.length+' failed';setBusy(false,message);if(errors.length)alert(message+'\\n\\n'+errors.slice(0,10).join('\\n'));loadPreview();return}setBusy(true,'Synchronizing '+Math.min(index+batch.length,chosen.length)+' of '+chosen.length+'…');google.script.run.withSuccessHandler(function(result){(result.results||[]).forEach(function(item){if(item.ok)success++;else errors.push(item.customerId+': '+item.error)});runBatch(direction,chosen,index+batch.length,success,errors)}).withFailureHandler(fail).applyPmosGoogleContactsMassSyncBatch(direction,batch)}function fail(error){setBusy(false,'Could not complete');alert(error&&error.message?error.message:String(error))}loadPreview();
var activeFilter='';function metric(label,value,status){return '<button type="button" class="metric'+(activeFilter===status?' active':'')+'" data-filter="'+status+'" onclick="setFilter(this.dataset.filter)"><b>'+value+'</b>'+label+'</button>'}function renderMetrics(){document.getElementById('summary').innerHTML=metric('Ready to review',preview.ready,'READY')+metric('Needs match review',preview.review,'REVIEW')+metric('No match',preview.unmatched,'UNMATCHED')+metric('Broken links',preview.broken,'BROKEN')}function renderPreview(data){preview=data;renderMetrics();renderRows();setBusy(false,data.ready+' safe matches available')}function setFilter(status){activeFilter=activeFilter===status?'':status;renderMetrics();renderRows()}function renderRows(){var rows=activeFilter?preview.rows.filter(function(row){return row.status===activeFilter}):preview.rows;document.getElementById('table').innerHTML='<table><thead><tr><th style="width:34px"><input id="all" type="checkbox" checked onchange="toggleAll(this.checked)"></th><th>PMOS customer</th><th>Google Contact / reason</th><th>Match</th><th>Different fields</th></tr></thead><tbody>'+rows.map(rowHtml).join('')+'</tbody></table>'+(rows.length?'':'<div class="empty">No customers in this category.</div>');document.getElementById('status').textContent=activeFilter?rows.length+' shown · click the selected card to show all':preview.ready+' safe matches available'}function rowHtml(row){var ready=row.status==='READY',details=[row.customerAddress,row.customerPhone,row.customerEmail].filter(Boolean).join(' · '),candidates=(row.candidates||[]).map(function(c){return '<div class="candidate">'+esc(c.displayName)+' — '+esc(c.matchReason)+(c.address?' · '+esc(c.address):'')+'</div>'}).join('');return '<tr><td>'+(ready?'<input class="pick" type="checkbox" checked data-id="'+esc(row.customerId)+'" data-resource="'+esc(row.resourceName)+'">':'')+'</td><td><b>'+esc(row.customerName)+'</b><div class="small">'+esc(details||row.customerId)+'</div></td><td>'+esc(row.contactName||row.explanation||'—')+(candidates?'<div class="small">Suggestions:'+candidates+'</div>':'')+'</td><td class="'+row.status.toLowerCase()+'">'+esc(ready?row.matchReason:row.status)+'</td><td>'+esc((row.differences||[]).join(', ')||'—')+'</td></tr>'}
function metric(label,value,status){return '<button type="button" class="metric'+(activeFilter===status?' active':'')+'" data-filter="'+status+'" onclick="setFilter(this.dataset.filter)"><b>'+value+'</b>'+label+'</button>'}
</script></body></html>`;
}
