td><td>'+esc(row.contactName||row.explanation||'—')+(candidates?'<div class="small">Suggestions:'+candidates+'</div>':'')+'</td><td class="'+row.status.toLowerCase()+'">'+esc(ready?row.matchReason:row.status)+'</td><td>'+esc((row.differences||[]).join(', ')||'—')+'</td></tr>'}
function metric(label,value,status){return '<button type="button" class="metric'+(activeFilter===status?' active':'')+'" data-filter="'+status+'" onclick="setFilter(this.dataset.filter)"><b>'+value+'</b>'+label+'</button>'}
