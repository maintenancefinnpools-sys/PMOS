/** Guarded mass synchronization between PMOS Customers and Google Contacts. */
function showPmosGoogleContactsMassSync() {
  const html = HtmlService.createHtmlOutput(buildPmosGoogleContactsMassSyncHtml_()).setWidth(1060).setHeight(760);
  SpreadsheetApp.getUi().showModelessDialog(html, 'Google Contacts Mass Sync');
}

