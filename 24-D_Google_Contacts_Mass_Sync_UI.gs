var preview=null,busy=false;function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}function setBusy(value,message){busy=value;['refresh','pull','push'].forEach(function(id){document.getElementById(id).disabled=value});document.getElementById('status').textContent=message||''}function metric(label,value){return '<div class="metric"><b>'+value+'</b>'+label+'</div>'}function loadPreview(){setBusy(true,'Building preview…');google.script.run.withSuccessHandler(renderPreview).withFailureHandler(fail).previewPmosGoogleContactsMassSync()}function renderPreview(data){preview=data;document.getElementById('summary').innerHTML=metric('Ready to review',data.ready)+metric('Needs match review',data.review)+metric('No match',data.unmatched)+metric('Broken links',data.broken);document.getElementById('table').innerHTML='<table><thead><tr><th style="width:34px"><input id="all" type="checkbox" checked onchange="toggleAll(this.checked)"></th><th>PMOS customer</th><th>Google Contact</th><th>Match</th><th>Different fields</th></tr></thead><tbody>'+data.rows.map(rowHtml).join('')+'</tbody></table>';setBusy(false,data.ready+' safe matches available')}function rowHtml(row){var ready=row.status==='READY',candidates=(row.candidates||[]).map(function(c){return '<div class="candidate">'+esc(c.displayName)+' — '+esc(c.matchReason)+'</div>'}).join('');return '<tr><td>'+(ready?'<input class="pick" type="checkbox" checked data-id="'+esc(row.customerId)+'" data-resource="'+esc(row.resourceName)+'">':'')+'</td><td><b>'+esc(row.customerName)+'</b><div class="small">'+esc(row.customerId)+'</div></td><td>'+esc(row.contactName||'—')+(candidates?'<div class="small">Candidates:'+candidates+'</div>':'')+'</td><td class="'+row.status.toLowerCase()+'">'+esc(ready?row.matchReason:row.status)+'</td><td>'+esc((row.differences||[]).join(', ')||'—')+'</td></tr>'}function toggleAll(checked){Array.prototype.forEach.call(document.querySelectorAll('.pick'),function(box){box.checked=checked})}function selections(){return Array.prototype.filter.call(document.querySelectorAll('.pick'),function(box){return box.checked}).map(function(box){return{customerId:box.dataset.id,resourceName:box.dataset.resource}})}function startSync(direction){var chosen=selections();if(!chosen.length){alert('Select at least one safely matched customer.');return}var verb=direction==='PULL'?'replace PMOS fields with Google Contact information':'replace Google Contact fields with PMOS information';if(!confirm(verb+' for '+chosen.length+' selected customer'+(chosen.length===1?'':'s')+'?\\n\\nOnly the customers checked in this preview will be changed.'))return;setBusy(true,'Preparing '+chosen.length+' customers…');runBatch(direction,chosen,0,0,[])}function runBatch(direction,chosen,index,success,errors){var batch=chosen.slice(index,index+12);if(!batch.length){var message='Complete: '+success+' synchronized';if(errors.length)message+=' · '+errors.length+' failed';setBusy(false,message);if(errors.length)alert(message+'\\n\\n'+errors.slice(0,10).join('\\n'));loadPreview();return}setBusy(true,'Synchronizing '+Math.min(index+batch.length,chosen.length)+' of '+chosen.length+'…');google.script.run.withSuccessHandler(function(result){(result.results||[]).forEach(function(item){if(item.ok)success++;else errors.push(item.customerId+': '+item.error)});runBatch(direction,chosen,index+batch.length,success,errors)}).withFailureHandler(fail).applyPmosGoogleContactsMassSyncBatch(direction,batch)}function fail(error){setBusy(false,'Could not complete');alert(error&&error.message?error.message:String(error))}loadPreview();
