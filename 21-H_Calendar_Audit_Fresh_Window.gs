<script>
(function(){
var body=document.getElementById('body'),stage=document.getElementById('stage'),elapsed=document.getElementById('elapsed'),result=document.getElementById('result'),inspector=document.getElementById('inspector'),seriesSearch=document.getElementById('seriesSearch'),showUnchanged=document.getElementById('showUnchanged'),seriesRows=document.getElementById('seriesRows'),seriesDiagnostics=[],runButton=document.getElementById('runButton'),syncButton=document.getElementById('syncButton'),errorsButton=document.getElementById('errorsButton'),warningsButton=document.getElementById('warningsButton'),matchesButton=document.getElementById('matchesButton'),deletionsButton=document.getElementById('deletionsButton'),unclassifiedButton=document.getElementById('unclassifiedButton'),calendarName=document.getElementById('calendarName'),startDate=document.getElementById('startDate'),endDate=document.getElementById('endDate'),includeStartedToday=document.getElementById('includeStartedToday'),closeButton=document.getElementById('closeButton'),started=0,clock=null;
var reviewButtons=[errorsButton,warningsButton,matchesButton,unclassifiedButton,deletionsButton,syncButton];
function formatElapsed(totalSeconds){var seconds=Math.max(0,Math.floor(Number(totalSeconds)||0));if(seconds<60)return seconds+'s';var hours=Math.floor(seconds/3600),minutes=Math.floor((seconds%3600)/60),remaining=seconds%60;if(hours>0)return hours+'h '+String(minutes).padStart(2,'0')+'m '+String(remaining).padStart(2,'0')+'s';return minutes+'m '+String(remaining).padStart(2,'0')+'s';}
function startClock(){if(clock)clearInterval(clock);clock=setInterval(function(){elapsed.textContent='Elapsed: '+formatElapsed((Date.now()-started)/1000);},1000);}
function setControlsDisabled(value){calendarName.disabled=value;startDate.disabled=value;endDate.disabled=value;includeStartedToday.disabled=value;}
function fail(error){if(clock)clearInterval(clock);body.className='failed';stage.textContent='Needs attention';result.textContent=error&&error.message?error.message:String(error);resetOpeningButtons();setControlsDisabled(false);runButton.disabled=false;runButton.classList.remove('opening');runButton.textContent='Run Audit';}
function escapeText(value){return String(value==null?'':value).replace(/[&<>"']/g,function(ch){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];});}
function renderSeries(){var query=String(seriesSearch.value||'').trim().toLowerCase();function actionInfo(item){var actions=item.actions||[];if(actions.indexOf('UPDATE')>=0)return{label:'UPDATE',rank:1,rowClass:'change-update',actionClass:'action-update'};if(actions.indexOf('CREATE')>=0)return{label:'CREATE',rank:2,rowClass:'change-create',actionClass:'action-create'};if(actions.indexOf('WARNING')>=0)return{label:'DELETE REVIEW',rank:3,rowClass:'change-delete',actionClass:'action-delete'};return{label:'No change',rank:4,rowClass:'no-change',actionClass:''};}var rows=seriesDiagnostics.filter(function(item){var info=actionInfo(item),matches=!query||[item.title,item.customerId,item.seriesKey,item.layer,info.label].join(' ').toLowerCase().indexOf(query)>=0;return matches&&(showUnchanged.checked||Boolean(query)||info.rank<4);}).sort(function(a,b){var left=actionInfo(a),right=actionInfo(b);return left.rank-right.rank||String(a.title||a.seriesKey).localeCompare(String(b.title||b.seriesKey));});seriesRows.innerHTML=rows.map(function(item){var info=actionInfo(item);return '<tr class="'+info.rowClass+'"><td><strong>'+escapeText(item.title||item.customerId||'Untitled')+'</strong><br><span class="muted">'+escapeText(item.seriesKey)+'</span></td><td class="state">'+(item.sourceRow?escapeText(item.sourceRow)+(item.stopOrder?' (stop '+escapeText(item.stopOrder)+')':''):'—')+'</td><td>'+escapeText(item.layer)+'</td><td class="state">'+(item.desiredPresent?'Yes':'No')+'</td><td class="state">'+(item.currentPresent?'Yes':'No')+'</td><td class="'+info.actionClass+'">'+info.label+'</td></tr>';}).join('')||'<tr><td colspan="6">No matching series.</td></tr>';}
function done(response){if(clock)clearInterval(clock);body.className='complete';stage.textContent='Complete';elapsed.textContent='Duration: '+formatElapsed(Math.max(1,Math.round((Date.now()-started)/1000)));result.textContent=response&&response.summary?response.summary:'Task completed.';seriesDiagnostics=response&&response.seriesDiagnostics||[];if(seriesDiagnostics.length){inspector.style.display='block';renderSeries();}runButton.style.display='none';if(response){if(response.hasErrors)errorsButton.style.display='inline-block';if(response.hasWarnings)warningsButton.style.display='inline-block';if(response.hasSuggestedMatches)matchesButton.style.display='inline-block';if(response.hasUnclassifiedEvents)unclassifiedButton.style.display='inline-block';if(Number(response.deletionCandidateCount||0)>0)deletionsButton.style.display='inline-block';if(response.reviewComplete)syncButton.style.display='inline-block';}}
function resetOpeningButtons(){reviewButtons.forEach(function(button){if(!button)return;button.disabled=false;button.classList.remove('opening');button.textContent=button.getAttribute('data-label')||button.textContent;});}
function openAction(button,label,serverFunction,closeParent){button.setAttribute('data-label',button.textContent);button.disabled=true;button.classList.add('opening');button.textContent='Opening '+label+'…';stage.textContent='Opening '+label+'…';google.script.run.withSuccessHandler(function(){if(closeParent){google.script.host.close();return;}button.textContent='Opened '+label;setTimeout(function(){button.disabled=false;button.classList.remove('opening');button.textContent=button.getAttribute('data-label');stage.textContent='Complete';},700);}).withFailureHandler(fail)[serverFunction]();}
function runAudit(){if(!calendarName.value){result.textContent='Select a Calendar before running the audit.';return;}if(!startDate.value||!endDate.value){result.textContent='Choose both a start date and an end date.';return;}if(startDate.value>endDate.value){result.textContent='The start date cannot be after the end date.';return;}runButton.disabled=true;runButton.classList.add('opening');runButton.textContent='Running…';setControlsDisabled(true);body.className='';stage.textContent='Working…';result.textContent='Starting Calendar Plan Audit for '+calendarName.value+'…';started=Date.now();startClock();google.script.run.withSuccessHandler(done).withFailureHandler(fail).runFreshPmosCalendarAuditWithOptions({calendarName:calendarName.value,startDate:startDate.value,endDate:endDate.value,includeStartedToday:includeStartedToday.checked});}
seriesSearch.oninput=renderSeries;
showUnchanged.onchange=renderSeries;
runButton.onclick=runAudit;
errorsButton.onclick=function(){openAction(errorsButton,'Errors','showCalendarAuditErrorsReview',false);};warningsButton.onclick=function(){openAction(warningsButton,'Warnings','showCalendarAuditWarningsReview',false);};matchesButton.onclick=function(){openAction(matchesButton,'Suggested Matches','showCalendarSuggestedMatchesReview',false);};unclassifiedButton.onclick=function(){openAction(unclassifiedButton,'Unclassified Events','showCalendarUnclassifiedExceptionsReview',false);};deletionsButton.onclick=function(){openAction(deletionsButton,'Suggested Deletions','showCalendarDeletionExceptionsReview',false);};syncButton.onclick=function(){openAction(syncButton,'Calendar Sync','openVerifiedCalendarSyncFromAudit',true);};closeButton.onclick=function(){closeButton.disabled=true;closeButton.classList.add('opening');closeButton.textContent='Closing…';setTimeout(function(){google.script.host.close();},120);};
})();
</script></body></html>`).setWidth(760).setHeight(760);

  SpreadsheetApp.getUi().showModelessDialog(html, 'Calendar Plan Audit');
}

function resetPmosCalendarReviewSessionForNewAudit_() {
  PropertiesService.getDocumentProperties().deleteProperty(PMOS_REVIEW_SESSION_PROPERTY);
  clearPmosCalendarAuditOptions_();
  clearPmosCalendarAuditSnapshot_();
  return {reset: true};
}
