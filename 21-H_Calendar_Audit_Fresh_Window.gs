12px}th,td{padding:7px 8px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:top}th{position:sticky;top:0;background:#f8fafc;z-index:1}.state{white-space:nowrap}tr.change-update td{background:#fff7d6}tr.change-create td{background:#ecfdf5}tr.change-delete td{background:#fff1f2}tr.no-change td{color:#64748b}.action-update{color:#92400e;font-weight:700}.action-create{color:#166534;font-weight:700}.action-delete{color:#991b1b;font-weight:700}.buttons{display:flex;gap:8px;align-items:center;flex-wrap:wrap;flex:0 0 auto;padding:12px 18px;background:#fff;border-top:1px solid #e2e8f0;box-shadow:0 -4px 12px rgba(15,23,42,.06);z-index:5}button{border:0;border-radius:8px;padding:9px 13px;font-weight:600;cursor:pointer;transition:background .15s,color .15s,opacity .15s,transform .08s}button:active{transform:translateY(1px)}.primary{background:#2563eb;color:#fff}.secondary{background:#e5e7eb;color:#111827}.warning{background:#fef3c7;color:#92400e}.warning.opening{background:#fff7d6!important;color:#c45f5f!important}.match{background:#dbeafe;color:#1e3a8a}.match.opening{background:#bfdbfe!important;color:#1e40af!important}.primary.opening{background:#1d4ed8!important;color:#fff!important}.secondary.opening{background:#cbd5e1!important;color:#334155!important}.waiting .bar{display:none}.complete .bar,.failed .bar{display:block;width:100%;left:0;animation:none}button:disabled{opacity:.82;cursor:default}select:disabled,input:disabled{opacity:.7;background:#f1f5f9}
</style></head><body id="body" class="waiting">
