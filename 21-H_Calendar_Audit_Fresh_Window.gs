/** Dedicated Calendar Plan Audit entry. */
function showFreshCalendarAuditTaskWindow() {
  resetPmosCalendarReviewSessionForNewAudit_();
  const launch = getPmosCalendarAuditLaunchOptions_();
  const calendarOptions = (launch.calendarNames || []).map(function (name) {
    const selected = name === launch.calendarName ? ' selected' : '';
    return '<option value="' + escapePmosSyncPreviewHtml_(name) + '"' + selected + '>' +
      escapePmosSyncPreviewHtml_(name) + '</option>';
  }).join('');

  const html = HtmlService.createHtmlOutput(`
