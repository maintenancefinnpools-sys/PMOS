  function heaterCard(unit){unit=unit||{};if(!compact([unit.make,unit.model,unit.type]))return'';var model=String(unit.model||''),capacity=(model.match(/\b(125|175|200|250|300|400)\b/)||[])[1],clean=model.replace(/\s+\b(125|175|200|250|300|400)\b.*$/,'').trim(),detail=compact([unit.type,capacity?Number(capacity).toLocaleString() + ',000 BTU':'']);return simpleCard('Heater',compact([unit.make,clean||model],' '),detail,unit.partNumber||unit.modelNumber,unit.partNumber?'Part Number':'Model Number',false)}
