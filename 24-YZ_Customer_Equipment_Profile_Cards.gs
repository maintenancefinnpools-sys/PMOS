  function chemistryCard(item){if(!item)return'';var d=details(item),rows=[],keys=[['Controller','controller'],['Configuration','configuration'],['Flow Cell','flowCell'],['pH Probe','phProbe'],['ORP Probe','orpProbe'],['Acid Tank','acidTank'],['Acid Pump Motor','acidPumpMotor'],['Pump Head','pumpHead'],['Chlorine Tank','chlorineTank'],['Chlorine Pump Motor','chlorinePumpMotor'],['Chlorine Pump Head','chlorinePumpHead']];keys.forEach(function(pair){var model=d[pair[1]+'Model'],part=d[pair[1]+'PartNumber'];if(model||part)rows.push([pair[0],compact([d.make||d.manufacturer,model]),part,'Part Number'])});if(!rows.length)rows.push(['System',compact([d.make||d.manufacturer,d.model])||'Chemistry Automation',d.partNumber||d.modelNumber,d.partNumber?'Part Number':'Model Number']);return tableCard('Chemistry Automation',compact([d.make||d.manufacturer,d.model]),rows)}
  function featureRows(d){var rows=[],parsed=arr(d.featureEquipment);if(!parsed.length){try{parsed=JSON.parse(d.featureEquipmentJson||'[]')}catch(ignore){parsed=[]}}arr(parsed).forEach(function(item){var x=details(item),prefix=item.type==='PUMP'?'pump':item.type==='FILTER'?'filter':item.type==='HEATER'?'heater':'featureEquipment',number=x[prefix+'PartNumber']||x[prefix+'ModelNumber']||x.partNumber||x.modelNumber||'',subject=compact([x[prefix+'Make']||x.make,x[prefix+'Model']||x.model]);rows.push([label(item.type),subject||label(item.type),number,(x[prefix+'PartNumber']||x.partNumber)?'Part Number':'Model Number'])});if(d.actuatorMake||d.actuatorModel||d.actuatorModelNumber){var actuatorNumber=d.actuatorPartNumber||d.actuatorModelNumber,knownPart=/^(263043|263044|263045|521485)$/.test(String(actuatorNumber||''));rows.push(['Valve Actuator',compact([d.actuatorMake,d.actuatorModel]),actuatorNumber,d.actuatorPartNumber||knownPart?'Part Number':'Model Number'])}return rows}
  function relationship(body,index,all){var type=String(body.type||body.name||'').toLowerCase(),spaType=String(body.spaType||''),setup=String(body.equipmentSetup||'');if(type.indexOf('spa')>=0){if(/spill-?over/i.test(spaType))return'Spillover';if(/attached/i.test(spaType))return'Attached Spa';if(setup==='Shared with Pool')return'Equipment Shared with Pool';return''}var spas=arr(all).filter(function(candidate){return /spa/i.test(String(candidate.type||candidate.name||''))});if(spas.some(function(spa){return /spill-?over/i.test(String(spa.spaType||''))}))return'Spillover';if(spas.some(function(spa){return /attached/i.test(String(spa.spaType||''))}))return'Attached Spa';if(spas.some(function(spa){return String(spa.equipmentSetup||'')==='Shared with Pool'}))return'Equipment Shared with Spa';return''}
  function renderBody(body,index,all){body=body||{};var items=arr(body.equipment),used={CHEMISTRY_AUTOMATION:true,FLOW_CELL:true,ACID_TANK:true,CHLORINE_TANK:true,PH_PROBE:true,ORP_PROBE:true,SALT_SYSTEM:true,CHLORINE_FEEDER:true,BROMINE_FEEDER:true,IONIZER:true,OZONATOR:true,UV:true,OTHER_SANITIZER:true,WATER_FEATURE:true},chem=items.filter(function(item){return item.type==='CHEMISTRY_AUTOMATION'})[0],automation=items.filter(function(item){return item.type==='EQUIPMENT_AUTOMATION'})[0],features=items.filter(function(item){return item.type==='WATER_FEATURE'}),cards='';cards+=pumpCard(body.pump);cards+=filterCard(body.filter);cards+=/^solar$/i.test(String(body.heater&&body.heater.type||''))?solarHeatingCard(body.heater):heaterCard(body.heater);cards+=coverCard(body.cover);if(automation){var ad=details(automation);cards+=simpleCard('Equipment Automation',compact([ad.manufacturer||ad.make,ad.model]),compact([ad.controller,ad.connectedTo]),ad.partNumber||ad.modelNumber,ad.partNumber?'Part Number':'Model Number',false);used.EQUIPMENT_AUTOMATION=true}cards+=sanitizerCard(body,items);cards+=chemistryCard(chem);features.forEach(function(item){var d=details(item),feature=title(d.featureType||d.name||'Water Feature'),rows=featureRows(d),heading='Water Feature: '+feature,featureDetail=compact([d.location,d.controlMethod||d.automation]);if(rows.length)cards+=tableCard(heading,featureDetail,rows);else cards+=simpleCard(heading,featureDetail,'','','',true)});items.forEach(function(item){if(used[item.type])return;var d=details(item),extra=compact([d.connectedTo,d.quantity?('Quantity '+d.quantity):'',d.notes]),number=d.partNumber||d.modelNumber||d.filterModelNumber,replacement=item.type==='FILTER'&&(d.cartridgeSetNumber||d.replacementCartridgePartNumber)||'';if(replacement)extra=compact([extra,'Replacement Cartridge']);cards+=simpleCard(label(item.type),itemSubject(item),extra,number,d.partNumber?'Part Number':'Model Number',false,replacement,'Part Number')});if(body.equipmentNotes)cards+='<div class="pmos-equipment-note"><strong>Equipment Notes</strong><br>'+esc(body.equipmentNotes)+'</div>';var meta='';if(body.shape)meta+='<span class="pmos-body-chip">'+esc(title(body.shape))+'</span>';if(body.volume)meta+='<span class="pmos-body-chip">'+esc(body.volume)+'</span>';var relation=relationship(body,index,all);if(relation)meta+='<span class="pmos-body-relation">'+esc(relation)+'</span>';return '<section class="pmos-body-profile"><div class="pmos-body-profile-head"><h4 class="pmos-body-profile-title">'+esc(title(body.name||body.type||('Body '+(index+1))))+'</h4><div class="pmos-body-meta">'+meta+'</div></div><div class="pmos-equipment-grid" data-pmos-adaptive-grid>'+cards+'</div></section>'}
